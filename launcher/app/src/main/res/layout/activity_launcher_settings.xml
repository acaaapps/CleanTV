<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="38dp"
        android:paddingBottom="38dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/reorderChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/reorder"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/rows_below_dock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dock_opacity_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/dream_name"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/clockSystem" style="@style/SettingsColumnChoice" android:text="@string/clock_format_system" />
            <TextView android:id="@+id/clock12" style="@style/SettingsColumnChoice" android:text="@string/clock_format_12" />
            <TextView android:id="@+id/clock24" style="@style/SettingsColumnChoice" android:text="@string/clock_format_24" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/screensaver_mode_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/screensaverNature" style="@style/SettingsColumnChoice" android:text="@string/screensaver_nature" />
            <TextView android:id="@+id/screensaverArt" style="@style/SettingsColumnChoice" android:text="@string/screensaver_art" />
            <TextView android:id="@+id/screensaverMix" style="@style/SettingsColumnChoice" android:text="@string/screensaver_mix" />
            <TextView android:id="@+id/screensaverClock" style="@style/SettingsColumnChoice" android:text="@string/screensaver_clock" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/screensaver_timeout_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/screensaverStartNow" style="@style/SettingsColumnChoice" android:text="@string/screensaver_start_now" />
            <TextView android:id="@+id/screensaverTimeout30s" style="@style/SettingsColumnChoice" android:text="@string/screensaver_timeout_30s" />
            <TextView android:id="@+id/screensaverTimeout1m" style="@style/SettingsColumnChoice" android:text="@string/screensaver_timeout_1m" />
            <TextView android:id="@+id/screensaverTimeout5m" style="@style/SettingsColumnChoice" android:text="@string/screensaver_timeout_5m" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/quotes_section_label"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/quotesToggleChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/quotes_filter_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/quotesTypeAll" style="@style/SettingsColumnChoice" android:text="@string/quotes_filter_all" />
            <TextView android:id="@+id/quotesTypeQuotes" style="@style/SettingsColumnChoice" android:text="@string/quotes_filter_quotes" />
            <TextView android:id="@+id/quotesTypePoems" style="@style/SettingsColumnChoice" android:text="@string/quotes_filter_poems" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/quotes_interval_label"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/quotesSpeedFast" style="@style/SettingsColumnChoice" android:text="@string/quotes_speed_fast" />
            <TextView android:id="@+id/quotesSpeedNormal" style="@style/SettingsColumnChoice" android:text="@string/quotes_speed_normal" />
            <TextView android:id="@+id/quotesSpeedSlow" style="@style/SettingsColumnChoice" android:text="@string/quotes_speed_slow" />
        </LinearLayout>

        <TextView
            android:id="@+id/quotesAuthorsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/quotes_authors_row" />

        <TextView
            android:id="@+id/wallpaperChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/animationsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/advancedChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/advanced_effects_warning"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/openOnStartChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/followThemeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/follow_theme" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/follow_theme_hint"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/defaultHomeChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="28dp"
            android:text="@string/home_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="@string/home_settings_help"
            android:textColor="#FFACB8C1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSettingsChoice"
            style="@style/SettingsRow"
            android:layout_marginTop="18dp"
            android:text="@string/tv_settings" />
    </LinearLayout>
</ScrollView>
