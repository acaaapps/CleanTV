<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 1. Apagar (Rojo) -->
        <FrameLayout
            android:id="@+id/btnPowerOff"
            android:layout_width="180dp"
            android:layout_height="110dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/power_btn_red"
            android:focusable="true"
            android:clickable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_power"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/power_off"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@string/font_medium" />
            </LinearLayout>
        </FrameLayout>

        <!-- 2. Reiniciar (Amarillo) -->
        <FrameLayout
            android:id="@+id/btnReboot"
            android:layout_width="180dp"
            android:layout_height="110dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/power_btn_yellow"
            android:focusable="true"
            android:clickable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_restart"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/reboot"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@string/font_medium" />
            </LinearLayout>
        </FrameLayout>

        <!-- 3. Salvapantallas (Verde) -->
        <FrameLayout
            android:id="@+id/btnScreensaver"
            android:layout_width="180dp"
            android:layout_height="110dp"
            android:background="@drawable/power_btn_green"
            android:focusable="true"
            android:clickable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_picture"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/screensaver_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@string/font_medium" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
